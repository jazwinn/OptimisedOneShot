# OptimisedOneShot .gitignore

# ── Model weights (large binary files) ───────────────────────────────
*.pt
*.pth
*.bin
*.onnx
*.engine
*.trt
*.ckpt
*.safetensors

# ── Output videos ────────────────────────────────────────────────────
outputs/
*.mp4
*.mov
*.avi
*.mkv

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Ultralytics cache ─────────────────────────────────────────────────
runs/
.ultralytics/

# ── Torch compile cache ───────────────────────────────────────────────
.cache/
torch_extensions/

# ── IDE / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Hydra / SAM2 outputs ─────────────────────────────────────────────
outputs/
multirun/
.hydra/
